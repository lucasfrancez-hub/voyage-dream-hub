{
  "info": {
    "name": "VIA AIR — API interna v1",
    "description": "Fachada oficial sobre o motor aéreo e o financeiro VIA AIR. Preencha as variáveis base_url e api_token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{api_token}}", "type": "string" }]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://pedidos.viaair.tur.br/api/public/internal/v1"
    },
    { "key": "api_token", "value": "vai_live_xxxxxxxxxxxxxxxxx" },
    { "key": "search_id", "value": "" },
    { "key": "offer_id", "value": "" },
    { "key": "checkout_id", "value": "" },
    { "key": "order_id", "value": "" },
    { "key": "payment_id", "value": "" }
  ],
  "item": [
    {
      "name": "Saúde",
      "item": [
        {
          "name": "Health",
          "request": { "method": "GET", "url": "{{base_url}}/health" }
        },
        {
          "name": "Situação do fornecedor",
          "request": { "method": "GET", "url": "{{base_url}}/oner/status" }
        }
      ]
    },
    {
      "name": "Voos",
      "item": [
        {
          "name": "Aeroportos",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/airports/search?query=rio&isDeparture=true"
          }
        },
        {
          "name": "Pesquisa de voos",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/flights/search",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"origin\": \"GRU\",\n  \"destination\": \"GIG\",\n  \"departureDate\": \"2026-10-12\",\n  \"returnDate\": \"2026-10-18\",\n  \"adults\": 1,\n  \"children\": 0,\n  \"infants\": 0\n}"
            }
          }
        },
        {
          "name": "Volta",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/flights/inbound",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"searchId\": \"{{search_id}}\",\n  \"outboundOfferId\": \"{{offer_id}}\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Checkout",
      "item": [
        {
          "name": "Criar checkout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "skyhub-checkout-0001" }
            ],
            "url": "{{base_url}}/checkouts",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"offerId\": \"{{offer_id}}\"\n}"
            }
          }
        },
        {
          "name": "Ler checkout",
          "request": { "method": "GET", "url": "{{base_url}}/checkouts/{{checkout_id}}" }
        },
        {
          "name": "Passageiros",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/checkouts/{{checkout_id}}/passengers",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"passengers\": [\n    {\n      \"firstName\": \"Maria\",\n      \"lastName\": \"Souza\",\n      \"passengerType\": \"ADT\",\n      \"birthDate\": \"1990-04-21\",\n      \"gender\": \"F\",\n      \"documentNumber\": \"12345678901\",\n      \"nationality\": \"BR\",\n      \"email\": \"maria@exemplo.com\",\n      \"phone\": \"44999999999\"\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "Reconferir tarifa",
          "request": { "method": "POST", "url": "{{base_url}}/checkouts/{{checkout_id}}/revalidate" }
        },
        {
          "name": "Formas de pagamento",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/checkouts/{{checkout_id}}/payment-methods"
          }
        }
      ]
    },
    {
      "name": "Pagamentos",
      "item": [
        {
          "name": "Parcelamento",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/checkouts/{{checkout_id}}/installments",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cardBin\": \"555544\",\n  \"amount\": 471.00\n}"
            }
          }
        },
        {
          "name": "Tokenizar cartão",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/checkouts/{{checkout_id}}/payments/card-token",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"holderName\": \"MARIA SOUZA\",\n  \"number\": \"5555444433332222\",\n  \"cvv\": \"123\",\n  \"expirationMonth\": \"12\",\n  \"expirationYear\": \"2029\",\n  \"documentNumber\": \"12345678901\"\n}"
            }
          }
        },
        {
          "name": "Pagar com cartão",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "skyhub-card-0001" }
            ],
            "url": "{{base_url}}/checkouts/{{checkout_id}}/payments/card",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cards\": [\n    { \"token\": \"...\", \"key\": \"...\", \"amount\": 471.00, \"installments\": 3 }\n  ],\n  \"payer\": {\n    \"name\": \"Maria Souza\",\n    \"document\": \"12345678901\",\n    \"email\": \"maria@exemplo.com\",\n    \"phone\": \"44999999999\",\n    \"zipCode\": \"87700000\",\n    \"street\": \"Rua X\",\n    \"number\": \"100\",\n    \"district\": \"Centro\",\n    \"city\": \"Paranavai\",\n    \"state\": \"PR\"\n  }\n}"
            }
          }
        },
        {
          "name": "Gerar Pix VIA AIR",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "skyhub-pix-0001" }
            ],
            "url": "{{base_url}}/checkouts/{{checkout_id}}/payments/pix",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"payer\": {\n    \"name\": \"Maria Souza\",\n    \"document\": \"12345678901\",\n    \"email\": \"maria@exemplo.com\"\n  }\n}"
            }
          }
        },
        {
          "name": "Situação do Pix do checkout",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/checkouts/{{checkout_id}}/payments/pix"
          }
        },
        {
          "name": "Situação do pagamento",
          "request": { "method": "GET", "url": "{{base_url}}/payments/{{payment_id}}" }
        },
        {
          "name": "Cancelar pagamento",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/checkouts/{{checkout_id}}/payments/cancel"
          }
        }
      ]
    },
    {
      "name": "Pedidos",
      "item": [
        {
          "name": "Criar pedido",
          "request": {
            "method": "POST",
            "header": [{ "key": "Idempotency-Key", "value": "skyhub-order-0001" }],
            "url": "{{base_url}}/checkouts/{{checkout_id}}/order"
          }
        },
        {
          "name": "Pedido completo",
          "request": { "method": "GET", "url": "{{base_url}}/orders/{{order_id}}" }
        },
        {
          "name": "Situação do pedido",
          "request": { "method": "GET", "url": "{{base_url}}/orders/{{order_id}}/status" }
        },
        {
          "name": "Bilhetes",
          "request": { "method": "GET", "url": "{{base_url}}/orders/{{order_id}}/tickets" }
        },
        {
          "name": "Documentos",
          "request": { "method": "GET", "url": "{{base_url}}/orders/{{order_id}}/documents" }
        }
      ]
    }
  ]
}
