{
  "name": "editair-desktop",
  "productName": "EditAir",
  "version": "1.0.0",
  "description": "EditAir — editor de vídeo local-first com IA online (VIA AIR)",
  "main": "main.cjs",
  "author": "VIA AIR",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dev": "EDITAIR_URL=http://localhost:8080/editair electron .",
    "build:mac": "electron-builder --mac --arm64",
    "build:mac:x64": "electron-builder --mac --x64",
    "build:win": "electron-builder --win --x64",
    "release:mac": "electron-builder --mac --arm64 --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0"
  },
  "devDependencies": {
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "br.tur.viaair.editair",
    "productName": "EditAir",
    "artifactName": "EditAir-${version}-${arch}.${ext}",
    "asar": true,
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**"
    ],
    "files": [
      "main.cjs",
      "preload.cjs",
      "lib/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": { "output": "dist" },
    "publish": [
      {
        "provider": "github",
        "owner": "REPLACE_OWNER",
        "repo": "REPLACE_REPO",
        "releaseType": "release"
      }
    ],
    "mac": {
      "category": "public.app-category.video",
      "target": [{ "target": "dmg", "arch": ["arm64"] }, { "target": "zip", "arch": ["arm64"] }],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "darkModeSupport": true
    },
    "dmg": { "title": "EditAir ${version}" },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }]
    },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
